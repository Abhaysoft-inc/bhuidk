// This is your Prisma schema file for PostgreSQL

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  role      Role     @default(PUBLIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PUBLIC
  RESEARCHER
  POLICYMAKER
  ADMIN
  GIS_ANALYST
}

model LandParcel {
  id          String   @id @default(uuid())
  ulpin       String   @unique // Unique Land Parcel Identification Number
  state       String
  district    String
  subDistrict String
  village     String
  area        Float    // Area in hectares
  ownerName   String
  landType    String   // Agricultural, Commercial, Residential, Forest, etc.
  status      String   // Clear, Disputed, Under Acquisition
  
  // JSONB for fast indexing of GeoJSON
  geometry    Json?    
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PolicyDocument {
  id            String   @id @default(uuid())
  title         String
  description   String
  documentUrl   String?
  issuer        String   // Ministry, State Govt, etc.
  effectiveDate DateTime
  
  chunks        DocumentChunk[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DocumentChunk {
  id               String         @id @default(uuid())
  policyDocumentId String
  policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id])
  content          String
  metadata         Json
  
  // pgvector embedding (1536 dims for OpenAI)
  embedding        Unsupported("vector(1536)")?
}

model AuditLog {
  id           String   @id @default(uuid()) // Transaction ID
  action       String   // e.g., "Simulation Run: Zonal FSI"
  initiator    String   // User email or system ID
  timestamp    DateTime @default(now())
  
  // Hash chaining for immutability
  previousHash String
  currentHash  String   @unique
}

model GovtScheme {
  id          String   @id @default(uuid())
  name        String
  description String
  budget      String
  keywords    String[] // Tags for matchmaking
  url         String?
}
