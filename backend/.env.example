# Environment
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (SQLite default; can point to postgresql://user:pass@localhost:5432/landgov)
DATABASE_URL=sqlite:///./land_governance.db

# JWT Secret
SECRET_KEY=change-this-to-a-secure-random-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Google Gemini API Key for LLM-powered legal synthesis
GEMINI_API_KEY=
